local function findMethod(class, name) {
  local method = getrawattr(class, name);
  if method != void { return method; }
  local parent = getrawattr(class, 'parent');
  if parent != void { return findMethod(parent, name); }
  return void;
}

local function isAssignableFrom(ancestor, cls) {
  local current = cls;
  while current != void {
    if current == ancestor { return true; }
    current = getrawattr(current, 'parent');
  }
  return false;
}

local function instanceof(obj, cls) {
  if obj == void { return false; }
  local objClass = getrawattr(obj, 'class');
  if objClass == void { return false; }
  return isAssignableFrom(cls, objClass);
}

local function callCtor(instance, cls, args...) {
  local parent = getrawattr(cls, 'parent');
  if parent != void { callCtor(instance, parent); }
  local ctor = getrawattr(cls, 'ctor');
  if ctor != void { ctor(instance, *args); }
}

local function class(parent=void) {
  local result = {parent=parent};
  setmetatable(result, {
    call=function(self, args...) {
      local instance = {class=self};
      setmetatable(instance, {
        get=function(target, name) {
          local value = getrawattr(target, name);
          if value != void { return value; }
          return findMethod(self, name);
        }
      });
      callCtor(instance, self, *args);
      return instance;
    }
  });
  return result;
}

return {class=class, instanceof=instanceof, isAssignableFrom=isAssignableFrom};
