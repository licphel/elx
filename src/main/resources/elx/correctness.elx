local Oop = require('oop.elx');
local complex = require('complex.elx');



// ============================================================
// ELX standard library smoke tests
// Run with: elx test-stdlib.elx
// ============================================================

print("== math ==");

local math = require("math");
// unary double functions
assert(math.abs(-3.5) == 3.5, "math.abs(-3.5)");
assert(math.sqrt(9.0) == 3.0, "math.sqrt(9)");
assert(math.floor(3.7) == 3.0, "math.floor(3.7)");
assert(math.ceil(3.2) == 4.0, "math.ceil(3.2)");
assert(math.sin(0.0) == 0.0, "math.sin(0)");
assert(math.cos(0.0) == 1.0, "math.cos(0)");
assert(math.tan(0.0) == 0.0, "math.tan(0)");
assert(math.asin(0.0) == 0.0, "math.asin(0)");
assert(math.acos(1.0) == 0.0, "math.acos(1)");
assert(math.atan(0.0) == 0.0, "math.atan(0)");
assert(math.log(math.exp(1.0)) > 0.999 && math.log(math.exp(1.0)) < 1.001, "math.log/exp");
assert(math.to_degrees(math.pi) > 179.9 && math.to_degrees(math.pi) < 180.1, "math.to_degrees(pi)");
assert(math.to_radians(180.0) > 3.14 && math.to_radians(180.0) < 3.15, "math.to_radians(180)");

// constants
assert(math.pi > 3.14 && math.pi < 3.15, "math.pi");
assert(math.inf > 1.0e308, "math.inf");

// pow / fmod / modf
assert(math.pow(2.0, 10.0) == 1024.0, "math.pow(2,10)");
assert(math.fmod(7.0, 3.0) == 1.0, "math.fmod(7,3)");
assert(math.fmod(-7.0, 3.0) == -1.0, "math.fmod(-7,3)");
assert(math.fmod(7.0, -3.0) == 1.0, "math.fmod(7,-3)");
local integral, frac = math.modf(3.75);
assert(integral == 3.0, "math.modf integral");
assert(frac > 0.74 && frac < 0.76, "math.modf fraction");
local negIntegral, negFrac = math.modf(-3.75);
assert(negIntegral == -3.0, "math.modf negative integral");
assert(negFrac > -0.76 && negFrac < -0.74, "math.modf negative fraction");

// min / max
assert(math.min(3.0, 1.0, 2.0) == 1.0, "math.min");
assert(math.max(3.0, 1.0, 2.0) == 3.0, "math.max");

// rand / randl / randf / randd / randb
local random = require("random");
local r = random.rand(1, 10);
assert(r >= 1 && r <= 10, "random.rand range");
local rl = random.randl(1, 10);
assert(rl >= 1 && rl <= 10, "random.randl range");
local rf = random.randf(0.0, 1.0);
assert(rf >= 0.0 && rf < 1.0, "random.randf range");
local rf2 = random.randf();
assert(rf2 >= 0.0 && rf2 < 1.0, "random.randf no-arg range");
local rd = random.randd(0.0, 1.0);
assert(rd >= 0.0 && rd < 1.0, "random.randd range");
local rd2 = random.randd();
assert(rd2 >= 0.0 && rd2 < 1.0, "random.randd no-arg range");
local rb = random.randb();
assert(type(rb) == "bool", "random.randb type");

print("== str ==");

// length / bytelen
assert(len("hello") == 5, "str.length ascii");
assert(len("你好") == 2, "str.length cjk");

local str = require('str');
// charAt / codeAt / fromCode
assert(str.charAt("abc", 0) == "a", "str.charAt(0)");
assert(str.charAt("abc", 2) == "c", "str.charAt(2)");
assert(str.codeAt("abc", 0) == 97, "str.codeAt(0)");
assert(str.codeAt("你", 0) == 20320, "str.codeAt cjk");
assert(str.fromCode(97) == "a", "str.fromCode(97)");
assert(str.fromCode(20320) == "你", "str.fromCode cjk");

// case
assert(str.toUpper("abc") == "ABC", "str.toUpper");
assert(str.toLower("ABC") == "abc", "str.toLower");

// sub / trim
assert(str.sub("hello", 1, 4) == "ell", "str.sub");
assert(str.sub("hello", 2) == "llo", "str.sub open end");
assert(str.trim("  hi  ") == "hi", "str.trim");
assert(str.trimStart("  hi") == "hi", "str.trimStart");
assert(str.trimEnd("hi  ") == "hi", "str.trimEnd");

// contains / startsWith / endsWith
assert(str.contains("hello", "ell"), "str.contains");
assert(str.containsIgnoreCase("Hello", "ELL"), "str.containsIgnoreCase");
assert(str.startsWith("hello", "he"), "str.startsWith");
assert(str.endsWith("hello", "lo"), "str.endsWith");

// index / lastIndex
assert(str.index("hello", "l") == 2, "str.index first");
assert(str.index("hello", "l", 3) == 3, "str.index from");
assert(str.index("hello", "z") == -1, "str.index missing");
assert(str.lastIndex("hello", "l") == 3, "str.lastIndex");

// compare / equalsIgnoreCase
assert(str.isSameIgnoreCase("Hello", "HELLO"), "str.isSameIgnoreCase");
assert(!str.isSameIgnoreCase("Hello", "World"), "str.isSameIgnoreCase false");

// replace / split / join
assert(str.replace("hello", "l", "L") == "heLLo", "str.replace");
local parts = str.split("a,b,c", ",");
assert(len(parts) == 3, "str.split length");
assert(parts[0] == "a" && parts[1] == "b" && parts[2] == "c", "str.split content");
assert(str.join("-", "a", "b", "c") == "a-b-c", "str.join");

// repeat / pad
assert(str.repeat("ab", 3) == "ababab", "str.repeat");
assert(str.padStart("7", 3, "0") == "007", "str.padStart");
assert(str.padEnd("7", 3, "0") == "700", "str.padEnd");

// format
assert(str.format("a={} b={}", 1, 2) == "a=1 b=2", "str.format");
assert(str.format("no placeholder") == "no placeholder", "str.format literal");

print("== io ==");

local tmp = "elx-stdlib-test.tmp";

// writeText / readText
local io = require('io');
io.writeText(tmp, "hello elx");
assert(io.readText(tmp) == "hello elx", "io.readText");

// appendText
io.appendText(tmp, "!");
assert(io.readText(tmp) == "hello elx!", "io.appendText");

// exists
assert(io.exists(tmp), "io.exists true");
assert(!io.exists("elx-stdlib-does-not-exist.tmp"), "io.exists false");

// listDir
local entries = io.listDir(".");
assert(len(entries) >= 1, "io.listDir non-empty");

// delete
io.delete(tmp);
assert(!io.exists(tmp), "io.delete");

print("== sys ==");

// identity returns a long payload for a value
assert(type(sys.identity(42)) == "long", "sys.identity type");

// remove on a table
local t = {a = 1, b = 2};
assert(sys.remove(t, "a"), "sys.remove existing");
assert(!sys.remove(t, "a"), "sys.remove missing");
assert(len(t) == 1, "sys.remove shrinks table");

// unload a missing module is a no-op
sys.unload("does.not.exist");

print("== gc ==");

local gc = require('gc');
// collect runs without error
gc.collect();


print("== util ==");

local util = require('util');
// base64 round trip
local encoded = util.encodeBase64("hello");
assert(encoded == "aGVsbG8=", "util.encodeBase64");
assert(util.decodeBase64(encoded) == "hello", "util.decodeBase64");

// time / date
local now = util.time();
assert(type(now) == "long" && now > 0, "util.time positive");
local iso = util.date(now);
assert(str.contains(iso, "T"), "util.date ISO-8601");
local isoNow = util.date();
assert(str.contains(isoNow, "T"), "util.date no-arg");

// genUuid
local uuid = util.genUuid();
assert(len(uuid) == 36, "util.genUuid length");
assert(str.charAt(uuid, 8) == "-", "util.genUuid hyphen at 8");

// ============================================================
// ELX list / table module tests
// Run with: elx test-list-table.elx
// ============================================================

local list = require("list");
local table = require("table");

// ------------------------------------------------------------
// list.copy / list.deepCopy
// ------------------------------------------------------------
print("list.copy / deepCopy");

local src = [1, 2, 3];
local shallow = list.copy(src);
assert(list.size(shallow) == 3, "copy size");
assert(shallow[0] == 1 && shallow[2] == 3, "copy elements");

local nested = [[1, 2], [3, 4]];
local shallowNested = list.copy(nested);
local deepNested = list.deepCopy(nested);
assert(list.size(shallowNested) == 2, "shallow nested size");
assert(list.size(deepNested) == 2, "deep nested size");
nested[0][0] = 99;
assert(shallowNested[0][0] == 99, "shallow copy shares nested list");
assert(deepNested[0][0] == 1, "deep copy isolates nested list");

// ------------------------------------------------------------
// list.sort / list.reverse
// ------------------------------------------------------------
print("list.sort / reverse");

local nums = [3, 1, 2];
list.sort(nums);
assert(nums[0] == 1 && nums[1] == 2 && nums[2] == 3, "sort numbers");

local words = ["b", "c", "a"];
list.sort(words);
assert(words[0] == "a" && words[1] == "b" && words[2] == "c", "sort strings");

local mixed = [3, 2.0, 1l];
list.sort(mixed);
assert(mixed[0] == 1l && mixed[1] == 2.0 && mixed[2] == 3, "sort mixed numeric values");

list.reverse(nums);
assert(nums[0] == 3 && nums[2] == 1, "reverse");

// ============================================================
// list.sort with custom lt hook
// ============================================================

local function version(major, minor) {
  local t = {major = major, minor = minor};
  setmetatable(t, {
    "lt" = function(a, b) {
      if (a.major != b.major) { return a.major < b.major; }
      return a.minor < b.minor;
    }
  });
  return t;
}

local versions = [
  version(2, 0),
  version(1, 10),
  version(1, 2),
  version(2, 1),
  version(1, 9)
];

list.sort(versions);

local expected = [
  [1, 2],
  [1, 9],
  [1, 10],
  [2, 0],
  [2, 1]
];

for (i = 0, i < list.size(versions), i += 1) {
  local v = versions[i];
  assert(v.major == expected[i][0], "version major at " + i);
  assert(v.minor == expected[i][1], "version minor at " + i);
}

local calls = {count = 0};
local function counted(value) {
  local t = {value = value};
  setmetatable(t, {
    "lt" = function(a, b) {
      calls.count += 1;
      return a.value < b.value;
    }
  });
  return t;
}

local countedList = [counted(3), counted(1), counted(2)];
list.sort(countedList);
assert(countedList[0].value == 1, "counted first");
assert(countedList[1].value == 2, "counted second");
assert(countedList[2].value == 3, "counted third");
assert(calls.count > 0, "lt hook was invoked");

local plain = [{x = 2}, {x = 1}];
local plainSorted, plainError = pcall(function() { list.sort(plain); }, function(error) { return error; });
assert(!plainSorted && str.contains(plainError.cause, "No COMPARE"), "plain tables require an ordering hook");
assert(plain[0].x == 2 && plain[1].x == 1, "failed sort preserves input");

print("list.sort lt hook tests passed");

// ------------------------------------------------------------
// list.insert / removeAt / remove / pop / push / clear
// ------------------------------------------------------------
print("list insert/remove");

local l = [1, 2, 3];
list.insert(l, 1, 99);
assert(list.size(l) == 4 && l[1] == 99 && l[2] == 2, "insert middle");

list.insert(l, list.size(l), 4);
assert(l[list.size(l) - 1] == 4, "insert append");

local removed = list.removeAt(l, 1);
assert(removed == 99, "removeAt returns value");
assert(list.size(l) == 4, "removeAt shrinks");

list.push(l, 5);
assert(l[list.size(l) - 1] == 5, "push");

local last = list.pop(l);
assert(last == 5, "pop returns last");
assert(list.size(l) == 4, "pop shrinks");

local l2 = [1, 2, 1, 3];
assert(list.remove(l2, 1), "remove existing");
assert(list.size(l2) == 3 && l2[0] == 2, "remove shifts");
assert(!list.remove(l2, 42), "remove missing");

list.clear(l2);
assert(list.size(l2) == 0, "clear");
assert(list.isEmpty(l2), "isEmpty after clear");

// ------------------------------------------------------------
// list.slice / concat / append / prepend
// ------------------------------------------------------------
print("list slice/concat/append");

local base = [10, 20, 30, 40];
local mid = list.slice(base, 1, 3);
assert(list.size(mid) == 2 && mid[0] == 20 && mid[1] == 30, "slice");

local tail = list.slice(base, 2);
assert(list.size(tail) == 2 && tail[0] == 30, "slice open end");

local joined = list.concat([1, 2, 3], "-");
assert(joined == "1-2-3", "concat");

local target = [1];
list.append(target, [2, 3]);
assert(list.size(target) == 3 && target[2] == 3, "append");

local head = [4, 5];
list.prepend(head, [1, 2, 3]);
assert(list.size(head) == 5 && head[0] == 1 && head[4] == 5, "prepend");

// ------------------------------------------------------------
// list.indexOf / lastIndexOf / contains / count
// ------------------------------------------------------------
print("list search");

local search = [10, 20, 10, 30];
assert(list.indexOf(search, 10) == 0, "indexOf first");
assert(list.indexOf(search, 10, 1) == 2, "indexOf from");
assert(list.indexOf(search, 99) == -1, "indexOf missing");
assert(list.lastIndexOf(search, 10) == 2, "lastIndexOf");
assert(list.contains(search, 20), "contains true");
assert(!list.contains(search, 99), "contains false");
assert(list.count(search, 10) == 2, "count");

// ------------------------------------------------------------
// list.unique / flatten / zip / chunk
// ------------------------------------------------------------
print("list transform");

local dup = [1, 2, 1, 3, 2];
local uniq = list.unique(dup);
assert(list.size(uniq) == 3, "unique size");
assert(uniq[0] == 1 && uniq[1] == 2 && uniq[2] == 3, "unique order");

local flat = list.flatten([[1, 2], 3, [4]]);
assert(list.size(flat) == 4, "flatten size");
assert(flat[0] == 1 && flat[3] == 4, "flatten elements");

local zipped = list.zip([1, 2], ["a", "b", "c"]);
assert(list.size(zipped) == 2, "zip size");
assert(zipped[0][0] == 1 && zipped[0][1] == "a", "zip pair");

local chunks = list.chunk([1, 2, 3, 4, 5], 2);
assert(list.size(chunks) == 3, "chunk count");
assert(list.size(chunks[0]) == 2 && list.size(chunks[2]) == 1, "chunk sizes");

// ------------------------------------------------------------
// list.swap / fill / sum / min / max
// ------------------------------------------------------------
print("list aggregate");

local swap = [1, 2, 3];
list.swap(swap, 0, 2);
assert(swap[0] == 3 && swap[2] == 1, "swap");

local filled = [1, 2, 3];
list.fill(filled, 7);
assert(filled[0] == 7 && filled[2] == 7, "fill");

assert(list.sum([1, 2, 3]) == 6.0, "sum");
assert(list.min([3, 1, 2]) == 1, "min");
assert(list.max([3, 1, 2]) == 3, "max");

// ------------------------------------------------------------
// list.equals / size / empty / repeat / range
// ------------------------------------------------------------
print("list construct");

assert(list.equals([1, 2], [1, 2]), "equals true");
assert(!list.equals([1, 2], [1, 3]), "equals false");
assert(!list.equals([1], [1, 2]), "equals length");

assert(list.size([1, 2, 3]) == 3, "size");
assert(list.isEmpty([]), "empty list isEmpty");
assert(!list.isEmpty([1]), "non-empty isEmpty");

local repeated = list.repeat("x", 3);
assert(list.size(repeated) == 3 && repeated[0] == "x", "repeat");

local ranged = list.range(1, 5, 2);
assert(list.size(ranged) == 2 && ranged[0] == 1 && ranged[1] == 3, "range step");

local down = list.range(5, 1, -2);
assert(list.size(down) == 2 && down[0] == 5 && down[1] == 3, "range negative step");

local emptyList = list.empty();
assert(list.isEmpty(emptyList), "empty");

// ------------------------------------------------------------
// table.keys / values / entries
// ------------------------------------------------------------
print("table keys/values/entries");

t = {a = 1, b = 2};
local keys = table.keys(t);
assert(list.size(keys) == 2, "keys size");
assert(list.contains(keys, "a") && list.contains(keys, "b"), "keys content");

local values = table.values(t);
assert(list.size(values) == 2, "values size");
assert(list.contains(values, 1) && list.contains(values, 2), "values content");

entries = table.entries(t);
assert(list.size(entries) == 2, "entries size");
local found = false;
for (entry in itr(entries)) {
  if (entry["key"] == "a" && entry["value"] == 1) {
    found = true;
  }
}
assert(found, "entries content");

// ------------------------------------------------------------
// table.merge / mergeInto / clone / invert
// ------------------------------------------------------------
print("table merge/clone/invert");

local left = {a = 1, b = 2};
local right = {b = 20, c = 30};
local merged = table.merge(left, right);
assert(merged["a"] == 1, "merge keeps left-only");
assert(merged["b"] == 20, "merge right overrides");
assert(merged["c"] == 30, "merge adds right-only");

local into = {a = 1};
table.mergeInto(into, {b = 2});
assert(into["a"] == 1 && into["b"] == 2, "mergeInto");

local cloned = table.clone({x = 1});
assert(cloned["x"] == 1, "clone value");
assert(table.size(cloned) == 1, "clone size");

local inverted = table.invert({a = 1, b = 2});
assert(inverted[1] == "a" && inverted[2] == "b", "invert");

// ------------------------------------------------------------
// table.has / get / clear / size / isEmpty
// ------------------------------------------------------------
print("table access");

local access = {a = 1, b = null};
assert(table.has(access, "a"), "has existing");
assert(table.has(access, "b"), "has null value");
assert(!table.has(access, "z"), "has missing");

assert(table.get(access, "a") == 1, "get existing");
assert(table.get(access, "z", 42) == 42, "get default");
assert(table.get(access, "z") == void, "get missing null");

assert(table.size(access) == 2, "table size");
assert(!table.isEmpty(access), "table non-empty");

local emptyTable = {};
assert(table.isEmpty(emptyTable), "table empty");
table.clear(access);
assert(table.size(access) == 0, "clear");
assert(table.isEmpty(access), "clear isEmpty");

print("all list/table tests passed");

print("all stdlib tests passed");
require("std-extensions.elx");

// Function itr
local cursor=[0];
local function iteratable() {
    if (cursor[0] > 10) {
        return void
    }
    return cursor[0]++
}

for i in iteratable {
    print i;
}
